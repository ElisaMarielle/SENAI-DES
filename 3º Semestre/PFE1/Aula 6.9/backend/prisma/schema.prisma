generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Produtos {
  id Int @id @default(autoincrement())
  nome String
  img_album String
  music_nomes String @db.VarChar(2000)
  genero String
  lancamento String
  preco Decimal
}